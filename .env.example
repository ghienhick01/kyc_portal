# ─── VerifyID KYC Portal — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-this-in-production-abc123xyz789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (SQLite by default; override for PostgreSQL in production) ───────
# DATABASE_URL=postgresql://user:password@localhost:5432/kyc_portal

# ── Cloudinary (Lead Cloud Engineer domain) ──────────────────────────────────
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Render / Railway Deployment ───────────────────────────────────────────────
# PORT=8000
# Set DEBUG=False and configure ALLOWED_HOSTS for production domain

# ── Security ──────────────────────────────────────────────────────────────────
# These are auto-configured when DEBUG=False
# SECURE_HSTS_SECONDS=31536000
# SECURE_SSL_REDIRECT=True
